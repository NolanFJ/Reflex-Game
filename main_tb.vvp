TD_main_tb.press_button ;
    %vpi_call 2 74 "$display", "Button press #%d at t=%0t", v0x700c6c1e0_0, $time {0 0 0};
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x700cb1860_0, 0, 1;
    %delay 1000000000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x700cb1860_0, 0, 1;
    %vpi_call 2 77 "$display", "Button released at t=%0t", $time {0 0 0};
    %end;
